# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (nếu dùng PostgreSQL thay vì SQLite)
# DB_NAME=weather_db
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# WeatherAPI
WEATHER_API_KEY=your-weatherapi-key-here
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# Firebase Cloud Messaging
# Lưu ý: Credentials thực tế nằm trong firebase-service-account.json
# File đó KHÔNG được commit vào git
FIREBASE_PROJECT_ID=your-firebase-project-id

# APScheduler
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# Notification Settings
NOTIFICATION_HISTORY_RETENTION_DAYS=90
MAX_DEVICE_TOKENS_PER_USER=5
DEVICE_TOKEN_INACTIVE_DAYS=90
